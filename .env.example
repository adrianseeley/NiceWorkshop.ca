NODE_ENV=development
PORT=3000
# Provision a separate Nice Workshop database. Never reuse another app's database.
DATABASE_URL=
# TLS is verified by default; provide the managed database CA when necessary.
DATABASE_CA_CERT=
# Local PostgreSQL only:
# DATABASE_SSL=disable
SHOPIFY_SHOP_DOMAIN=waj4za-5t.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
# A long random secret stored only on the server and supplied as a Bearer token.
ADMIN_API_TOKEN=
# Use a dedicated SMTP token, never your Proton account password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=hello@niceworkshop.ca
SMTP_PASSWORD=
EMAIL_FROM=hello@niceworkshop.ca
EMAIL_REPLY_TO=hello@niceworkshop.ca
# Live checkout remains unavailable until end-to-end checkout and delivery are verified.
CHECKOUT_ENABLED=false
PUBLIC_ORIGIN=http://localhost:3000
CHECKOUT_MODE=test
# Set only after confirming Shopify Payments test mode in the store.
SHOPIFY_TEST_MODE_CONFIRMED=false
# Set only after active registration and successful live-readiness checks.
HST_REGISTRATION_CONFIRMED=false
LIVE_CHECKOUT_VERIFIED=false
# Optional analytics stays off until the PostHog free project is connected.
ANALYTICS_ENABLED=false
ANALYTICS_BOT_TRACKING_ENABLED=false
# Public ingestion token only (phc_...), never a personal API key.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
